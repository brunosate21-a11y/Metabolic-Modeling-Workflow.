configfile: "config/config.yaml"

# --- 1) Deteção automática dos MAGs (TEM de vir antes dos includes) ---
MAGS_DIR = config.get("mags_dir", "data/mags")

if config.get("MAGS"):
    MAGS = config["MAGS"]
else:
    MAGS, = glob_wildcards(f"{MAGS_DIR}/{{mag}}.faa")

if not MAGS:
    raise ValueError(
        f"Nenhum ficheiro .faa encontrado em '{MAGS_DIR}'. "
        "Coloca os MAGs lá ou define 'MAGS:' no config.yaml."
    )

include: "rules/checkm.smk"
include: "rules/carveme.smk"
include: "rules/memote.smk"
include: "rules/micom.smk"
include: "rules/smetana.smk"
include: "rules/steadycom.smk"

onstart:
    print("\n--- Analysis started ---\n")
    print(f"--- MAGs detected: {len(MAGS)} -> {MAGS} ---\n")

onsuccess:
    print("\n--- Workflow finished! ---\n")

onerror:
    print("\n--- An error occurred! ---\n")

rule all:
    default_target: True
    input:
        expand("results/gems/{mag}.xml", mag=MAGS),
        expand("results/memote/{mag}/report.html", mag=MAGS),
        expand("results/memote/{mag}/score.json", mag=MAGS),
        "results/memote/memote_summary.tsv",
        "results/memote/memote_quality.tsv",
        "results/memote/filtered_models.txt",
        "results/micom/exchange_fluxes.tsv",
        "results/smetana/global.tsv",
        "results/smetana/detailed.tsv",
        "results/steadycom/abundances.tsv",
        "results/checkm/checkm_summary.tsv",
        "results/checkm/filtered_mags.txt",